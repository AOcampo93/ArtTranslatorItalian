{
  "name": "art-translator-italian-diagnostico",
  "version": "1.0.0",
  "description": "ArtTranslatorV2: traductor en vivo de italiano o inglés a español, con respuestas sugeridas en el idioma de la reunión",
  "main": "src/mainApp.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win dir --x64",
    "diag": "electron src/main.js"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.arturoocampo.arttranslatorv2",
    "productName": "ArtTranslatorV2",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../node-backend",
        "to": "node-backend",
        "filter": [
          "src/**/*",
          "test/fixtures/**/*",
          "package.json"
        ]
      },
      {
        "from": "../node-backend/node_modules",
        "to": "node-backend/node_modules",
        "filter": [
          "**/*",
          "!onnxruntime-node/bin/napi-v3/darwin/**",
          "!onnxruntime-node/bin/napi-v3/linux/**",
          "!onnxruntime-web/**",
          "!@img/sharp-darwin-arm64/**",
          "!@img/sharp-libvips-darwin-arm64/**",
          "!**/*.md",
          "!**/*.map"
        ]
      },
      {
        "from": "../shared",
        "to": "shared",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "../LEEME-WINDOWS.txt",
        "to": "LEEME.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "compression": "store"
  }
}
