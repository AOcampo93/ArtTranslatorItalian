# Copia este archivo a .env (que queda fuera de git) y pon valores reales.
# El receptor se niega a arrancar sin INFORMES_TOKEN.
INFORMES_TOKEN=cámbiame

# Vista privada (F039c): usuario y clave de HTTP Basic para listar y
# descargar en https://arturoocampo.com/informes/. Si falta cualquiera de
# las dos, el receptor arranca igual pero la vista no existe (404) — la
# subida (INFORMES_TOKEN, arriba) sigue funcionando sin ellas.
INFORMES_USUARIO=cámbiame
INFORMES_CLAVE=cámbiame

# Licencias (F053): POST /informes/licencias/activar. Sin una clave válida esa
# ruta responde 503 y el resto del receptor funciona igual.
# Clave privada Ed25519 (PKCS8, PEM) que firma los permisos. Se genera EN LOCAL
# con `node licencias-cli.js claves <archivo>` y va en UNA sola línea, con los
# saltos de línea escritos como \n (ver «Licencias» en LEEME.md). Nunca a git.
LICENCIAS_CLAVE_PRIVADA=
# Días de vigencia de cada permiso (entero de 1 a 365; 14 si falta). Cambiarlo
# no exige una versión nueva de la app.
LICENCIAS_DIAS=14
# Texto que la app muestra a quien no puede activar (límite de equipos o
# licencia no válida). Si falta, sale un texto genérico.
LICENCIAS_CONTACTO=
