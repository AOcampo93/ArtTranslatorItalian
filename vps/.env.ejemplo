# Copia este archivo a .env (que queda fuera de git) y pon valores reales.
# El receptor se niega a arrancar sin INFORMES_TOKEN.
INFORMES_TOKEN=cámbiame

# Vista privada (F039c): usuario y clave de HTTP Basic para listar y
# descargar en https://arturoocampo.com/informes/. Si falta cualquiera de
# las dos, el receptor arranca igual pero la vista no existe (404) — la
# subida (INFORMES_TOKEN, arriba) sigue funcionando sin ellas.
INFORMES_USUARIO=cámbiame
INFORMES_CLAVE=cámbiame
