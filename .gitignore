# Dependencias
node_modules/

# Compilados y empaquetado
dist/
build/
out/
*.exe

# Modelos: pesan cientos de MB, no van a git
*.bin
*.onnx
models/
whisper-cpp/

# Secretos
.env
.env.*
!.env.example
!.env.ejemplo

# Datos de sesión y transcripciones
# Con barra, el patrón queda anclado a la raíz: `data/*.db` NO cubría
# `node-backend/data/`, y la base de datos de una ejecución real llegó a
# quedarse preparada para el commit.
**/data/*.db
*.sqlite
*.jsonl

# Sistema
.DS_Store
Thumbs.db

# Binarios de desarrollo (los de producción se anclan al tag b5130)
bin/

electron-app/node_modules/

# Artefactos de construcción y binarios descargados
vendor/
bin-win/
*.zip

# vps/: receptor de informes en la nube (F039a). El token real no entra a
# git; el ejemplo sí, aunque .env.* ya lo taparía por el nombre.
vps/.env
!vps/.env.ejemplo
vps/informes/

# F039b: token de subida del cliente (secreto de servicio, no de usuario:
# viaja incrustado en el paquete de Windows). El ejemplo sí entra a git.
electron-app/src/informes.token.json

# F032: capturas de pantalla de herramientas/captura-demo.js, para revisar
# la interfaz sin abrir Electron. Son artefactos locales, no producto.
capturas/
